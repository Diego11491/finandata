# Data Lake local o Azure
STORAGE_MODE=local
REJECTION_THRESHOLD=0.01

# Opcional: Azure Data Lake Storage Gen2
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=finandata

# Warehouse compartido Azure SQL (no subir este archivo a Git)
WAREHOUSE_ENGINE=azure_sql
AZURE_SQL_SERVER=nombre-servidor.database.windows.net
AZURE_SQL_DATABASE=nombre-base-datos
AZURE_SQL_USERNAME=usuario-sql
AZURE_SQL_PASSWORD=
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
AZURE_SQL_SCHEMA=finandata

# Trazabilidad: usa el hash corto del commit en una entrega versionada
PIPELINE_GIT_COMMIT=local-dev
